<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base do app -->
    <style name="Base.Theme.Pi_Maya" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary = Ciano -->
        <item name="colorPrimary">@color/ciano</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/ciano_pp</item>
        <item name="colorOnPrimaryContainer">@color/petroleo</item>

        <!-- Secondary = Coral -->
        <item name="colorSecondary">@color/coral</item>
        <item name="colorOnSecondary">@color/text_on_coral</item>
        <item name="colorSecondaryContainer">@color/coral_claro</item>
        <item name="colorOnSecondaryContainer">@color/coral_escuro</item>

        <!-- Tertiary = Petróleo -->
        <item name="colorTertiary">@color/petroleo</item>
        <item name="colorOnTertiary">@color/text_on_petroleo</item>
        <item name="colorTertiaryContainer">@color/bege</item>
        <item name="colorOnTertiaryContainer">@color/text_on_bege</item>

        <!-- Background / Surface -->
        <item name="android:colorBackground">@color/fundo</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/branco</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bege_claro</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Error -->
        <item name="colorError">@color/erro</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/erro_claro</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- StatusBar / NavigationBar -->
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:navigationBarColor">@color/fundo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Tipografia base -->
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Maya.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Maya.BodyMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Maya.TitleLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Maya.HeadlineMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Maya.LabelLarge</item>

        <!-- Default fontFamily: Roboto (padrão Android) para todo o app -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Pi_Maya" parent="Base.Theme.Pi_Maya" />

    <!-- ===== Tipografia acessível para idosos =====
         Para o LOGO e destaques, usamos sans-serif-medium como fallback.
         Quando você tiver o arquivo Arista Pro Semibold (.ttf), salve em
         res/font/arista_pro_semibold.ttf e altere "sans-serif-medium" para
         "@font/arista_pro_semibold" nos estilos abaixo. -->

    <style name="TextAppearance.Maya.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Maya.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Maya.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Maya.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- HeadlineMedium = destaque (logo, cabeçalhos grandes). Aqui usa Arista Pro futuramente. -->
    <style name="TextAppearance.Maya.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- ===== Botões ===== -->

    <style name="Widget.Maya.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="backgroundTint">@color/petroleo</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Maya.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="strokeColor">@color/petroleo</item>
        <item name="android:textColor">@color/petroleo</item>
    </style>

    <style name="Widget.Maya.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/petroleo</item>
    </style>

    <!-- ===== Inputs ===== -->

    <style name="Widget.Maya.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/ciano_escuro</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/petroleo</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- ===== Cards ===== -->

    <style name="Widget.Maya.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/branco</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- BottomNavigation -->
    <style name="Widget.Maya.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">28dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Maya.LabelLarge</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>
