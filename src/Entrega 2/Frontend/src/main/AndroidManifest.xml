<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Conexão de rede para Supabase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Câmera (para MediaPipe na fase de exercícios) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Notificações (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Biometria (login com digital/face) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Anexos no chat (galeria) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".MayaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pi_Maya"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!-- Splash screen entry point -->
        <activity
            android:name=".presentation.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Pi_Maya">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding -->
        <activity
            android:name=".presentation.onboarding.OnboardingActivity"
            android:exported="false" />

        <!-- Auth -->
        <activity
            android:name=".presentation.auth.LoginActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".presentation.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".presentation.auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Auth callback (deep link do email de confirmação Supabase) -->
        <activity
            android:name=".presentation.auth.AuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="pi-maya"
                    android:host="auth"
                    android:path="/callback" />
            </intent-filter>
        </activity>

        <!-- Main app shell -->
        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="false" />

        <!-- Chat -->
        <activity
            android:name=".presentation.chat.ChatRoomActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Exercise detail -->
        <activity
            android:name=".presentation.exercises.ExerciseDetailActivity"
            android:exported="false" />

        <!-- Exercise camera (MediaPipe) -->
        <activity
            android:name=".presentation.exercises.ExerciseCameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            tools:ignore="LockedOrientationActivity" />

        <!-- Content detail -->
        <activity
            android:name=".presentation.content.ContentDetailActivity"
            android:exported="false" />

        <!-- MainActivity legada removida em favor de SplashActivity como launcher -->

    </application>

</manifest>
