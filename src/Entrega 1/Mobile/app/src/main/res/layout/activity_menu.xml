<?xml version="1.0" encoding="utf-8"?>
<!-- Layout principal do Menu com fundo escuro -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:padding="8dp">

    <!-- Layout interno com fundo degradê -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_degrade_login"
        android:padding="16dp">

        <!-- Container onde os Fragments são carregados dinamicamente -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/linhaSeparadoraMenu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Linha separadora entre o conteúdo e o menu inferior -->
        <View
            android:id="@+id/linhaSeparadoraMenu"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            app:layout_constraintBottom_toTopOf="@+id/menuInferiorMenu" />

        <!-- Barra de navegação inferior com 4 ícones -->
        <LinearLayout
            android:id="@+id/menuInferiorMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Ícone Home — navega para o menu principal -->
            <ImageView
                android:id="@+id/iconeHome"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/icone_home"
                app:tint="#000000" />

            <!-- Ícone Chat — navegação futura -->
            <ImageView
                android:id="@+id/iconeChat"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/icone_chat"
                app:tint="#000000" />

            <!-- Ícone Notificação — navegação futura -->
            <ImageView
                android:id="@+id/iconeNotificacao"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/icone_notific"
                app:tint="#000000" />

            <!-- Ícone Perfil — navega para o PerfilFragment -->
            <ImageView
                android:id="@+id/iconePerfil"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/icone_user"
                app:tint="#000000" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>